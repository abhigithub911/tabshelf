{
  "manifest_version": 3,
  "name": "Tabshelf - Tab Manager & New Tab Board",
  "short_name": "Tabshelf",
  "version": "2.2.0",
  "description": "Save tabs, quick links, notes and to-dos into colorful groups on your new tab page. Free, private, no account.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "unlimitedStorage", "tabs", "tabGroups", "favicon", "contextMenus", "topSites", "search", "alarms", "notifications"],
  "optional_permissions": ["bookmarks"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Save to Tabshelf",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+U", "mac": "Alt+Shift+U" },
      "description": "Open the Tabshelf save popover"
    },
    "save-tab": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Save the current tab to Read later"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
